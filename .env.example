# Copy to .env and fill in real values. Never commit .env itself.

# --- Core Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=FALSE
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL + pgvector) ---
DB_NAME=lepmits
DB_USER=lepmits
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email (OTP / notifications) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Production hardening (see config/settings.py) ---
# Comma-separated, must include scheme, e.g. https://lepmits.example.gov
CSRF_TRUSTED_ORIGINS=
# Set TRUE only once this app is confirmed to sit behind a reverse proxy
# (nginx/Caddy/etc.) that overwrites X-Forwarded-Proto rather than passing
# through whatever the client sent — see the settings.py comment.
BEHIND_HTTPS_PROXY=FALSE

# --- LLM backends (used by documents/rag/*) ---
# Each *_BACKEND picks one of: claude | gemini | ollama
LLM_BACKEND=gemini
LEGAL_BASIS_BACKEND=gemini

ANTHROPIC_API_KEY=
CLAUDE_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# --- Ollama (local models — OCR vision, embeddings, general drafting AI) ---
OLLAMA_ENDPOINT=http://100.74.22.65:11434/api/generate
OLLAMA_MODEL=
OLLAMA_MODEL_ANALYSIS=
OLLAMA_VISION_MODEL=
OLLAMA_OCR_MODEL=ALIENTELLIGENCE/attorney2:latest
# Must output vectors matching documents.models.EMBEDDING_DIMENSIONS (4096) —
# embed_text() will raise clearly if it doesn't.
OLLAMA_EMBED_MODEL=

# --- AI Legal Basis external lookups ---
# Set FALSE to keep unpublished draft titles from ever reaching the public
# Open Congress API / LawPhil.net.
RAG_EXTERNAL_LAW_SEARCH_ENABLED=TRUE

# --- Local binaries (defaults below match a standard Windows install;
#     on Linux, "soffice"/"tesseract" on PATH usually needs no override) ---
# LIBREOFFICE_PATH=
# TESSERACT_PATH=

# --- Sibling public Gazette site (separate project, github.com/Louiee-16/Gazette,
#     reads this same DB directly) — the homepage's search bar and "Browse
#     Ordinances" links point here instead of this repo's own smaller
#     OfficialGazette app. No scheme-less value, no trailing slash.
GAZETTE_SITE_URL=http://localhost:1625
